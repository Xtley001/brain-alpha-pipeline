# Copy to .env for local dev only. NEVER commit a real .env file.
# On Render, set these in the dashboard's Environment tab instead.

DATABASE_URL=postgresql://user:password@host/dbname
BRAIN_USERNAME=your_brain_username
BRAIN_PASSWORD=your_brain_password
BRAIN_MAX_CONCURRENT_SIMS=3

# Update 07: Gemini is no longer in the default provider chain (GCP billing
# gates its quota -- see pipeline/llm/adapter.py docstring). Leave these
# unset; build_gemini_provider() is still there if you want to wire it
# back in later once billing is sorted.
# GEMINI_API_KEY_1=replace_with_your_gemini_key_project_1
# GEMINI_API_KEY_2=replace_with_your_gemini_key_project_2

GROQ_API_KEY_1=replace_with_your_groq_key_account_1
GROQ_API_KEY_2=replace_with_your_groq_key_account_2
GROQ_API_KEY_3=replace_with_your_groq_key_account_3
GROQ_API_KEY_4=replace_with_your_groq_key_account_4

# Update 09: Cerebras free tier -- no card, ~1M tokens/day, resets daily.
# Sign up at cloud.cerebras.ai. Second full provider in the chain (after
# Groq, before OpenRouter), not a fallback -- see pipeline/llm/adapter.py.
# One key is normally plenty given the daily token budget; up to 4
# supported for consistency with the other providers. All optional.
CEREBRAS_API_KEY_1=replace_with_your_cerebras_key_account_1
CEREBRAS_API_KEY_2=replace_with_your_cerebras_key_account_2
CEREBRAS_API_KEY_3=replace_with_your_cerebras_key_account_3
CEREBRAS_API_KEY_4=replace_with_your_cerebras_key_account_4

# Update 07/08: OpenRouter free `:free`-tier, third leg of the chain -- no
# card required, sign up at openrouter.ai/keys. Up to 4 keys/accounts
# supported (4 separate emails/signups) -- each adds another ~50 req/day of
# headroom since OpenRouter's free cap is per-account, not a shared pool.
# This does NOT raise the 20 req/min cap, which OpenRouter enforces per
# account regardless of how many you rotate through. Leave any of these
# unset to run with fewer accounts; all 4 are optional.
OPENROUTER_API_KEY_1=replace_with_your_openrouter_key_account_1
OPENROUTER_API_KEY_2=replace_with_your_openrouter_key_account_2
OPENROUTER_API_KEY_3=replace_with_your_openrouter_key_account_3
OPENROUTER_API_KEY_4=replace_with_your_openrouter_key_account_4

TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id

QUEUE_TARGET_DEPTH=75
STAGE0_MIN_FITNESS=0.3
STAGE0_MIN_SHARPE=0.5

FILTER_MIN_SHARPE=1.25
FILTER_MIN_FITNESS=1.0
FILTER_MAX_TURNOVER=0.70
FILTER_MIN_TURNOVER=0.01
